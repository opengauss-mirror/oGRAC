SQL> -- Cache non-equality CONNECT BY matches over a joined NUMBER2 input.
SQL> drop table if exists t_hier_match_test;

Succeed.

SQL> create table t_hier_match_test(node_no number2);

Succeed.

SQL> begin
  2   for k in 1..200 loop
  3     insert into t_hier_match_test values(k);
  4   end loop;
  5   commit;
  6 end;
  7 /

PL/SQL procedure successfully completed.

SQL> analyze table t_hier_match_test compute statistics;

Succeed.

SQL> explain select count(*) hierarchy_rows
  2 from t_hier_match_test a join t_hier_match_test b on a.node_no=b.node_no
  3 connect by nocycle prior a.node_no between b.node_no and b.node_no+1 or prior b.node_no like a.node_no;

