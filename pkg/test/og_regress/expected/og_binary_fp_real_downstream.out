SQL> prompt === downstream arithmetic uses existing REAL ===

=== downstream arithmetic uses existing REAL ===
SQL> -- Oracle BINARY_FLOAT re-quantizes this addition to 16777216; oGRAC REAL returns 16777217.
SQL> select to_binary_float('16777216') + 1 as bf_add_one from sys.sys_dummy;

BF_ADD_ONE
--------------------
16777217

1 rows fetched.

SQL> select case when to_binary_float('16777216') + 1 = 16777217
  2        then 'PASS' else 'FAIL' end as bf_add_real_check from sys.sys_dummy;

BF_ADD_REAL_CHECK
-----------------
PASS

1 rows fetched.

SQL> -- Both use binary64 here; 2^53 + 1 rounds back to 2^53.
SQL> select to_binary_double('9007199254740992') + 1 as bd_add_one from sys.sys_dummy;

BD_ADD_ONE
--------------------
9.00719925474099e+15

1 rows fetched.

SQL> select case when to_binary_double('9007199254740992') + 1 =
  2                       to_binary_double('9007199254740992')
  3        then 'PASS' else 'FAIL' end as bd_add_binary64_check from sys.sys_dummy;

BD_ADD_BINARY64_CHECK
---------------------
PASS

1 rows fetched.

SQL> -- oGRAC REAL division raises OG-00637; Oracle binary floating-point division returns Inf.
SQL> select to_binary_float('1') / 0 as bf_div_zero from sys.sys_dummy;

OG-00637, [1:8]The divisor was zero
SQL> select to_binary_double('1') / 0 as bd_div_zero from sys.sys_dummy;

OG-00637, [1:8]The divisor was zero
