

SQL> -- A-compatible downstream contract after TO_BINARY_FLOAT/DOUBLE return OG_TYPE_REAL.
SQL> -- Differences from Oracle independent BINARY_FLOAT/BINARY_DOUBLE types are intentional.
SQL> -- The F-suffixed literal requires Bison; preceding schedule cases may disable it.
SQL> alter system set use_bison_parser = true scope = memory;

Succeed.

SQL> set pagesize 200


SQL> set linesize 240


SQL>
SQL> prompt === result descriptor and physical width ===

=== result descriptor and physical width ===
SQL> desc -q select to_binary_float('1.25') as bf_result;

Name                                Null?    Type
----------------------------------- -------- ------------------------------------
BF_RESULT                                    BINARY_DOUBLE

SQL> desc -q select to_binary_double('1.25') as bd_result;

Name                                Null?    Type
----------------------------------- -------- ------------------------------------
BD_RESULT                                    BINARY_DOUBLE

SQL> select vsize(to_binary_float('1.25')) as bf_expr_size,
  2        vsize(to_binary_double('1.25')) as bd_expr_size
  3 from sys.sys_dummy;

BF_EXPR_SIZE         BD_EXPR_SIZE
-------------------- --------------------
8                    8

1 rows fetched.

