SQL> -- Keep statistics absent and scan 65 composite LIST partitions to cover the CBO sampling bound.
SQL> declare
  2     ddl_sql varchar2(32767) := 'create table cbo_part_bound_t (id integer, sub_id integer) partition by list(id) subpartition by list(sub_id) (';
  3 begin
  4     for i in 0..64 loop
  5         if i > 0 then
  6             ddl_sql := ddl_sql || ',';
  7         end if;
  8         ddl_sql := ddl_sql || 'partition p' || i || ' values (' || i || ') (subpartition sp' || i || ' values (' || i || '))';
  9     end loop;
 10     execute immediate ddl_sql || ')';
 11 end;
 12 /

PL/SQL procedure successfully completed.

SQL> 
SQL> declare
  2 begin
  3     for i in 0..64 loop
  4         insert into cbo_part_bound_t values(i, i);
  5     end loop;
  6     commit;
  7 end;
  8 /

PL/SQL procedure successfully completed.

