SQL> -- Function indexes must distinguish DEFAULT values from format arguments.
SQL> create table t_bd_default_idx (id integer, txt varchar(40));

Succeed.

SQL> insert into t_bd_default_idx values (1, 'bad');

1 rows affected.

SQL> insert into t_bd_default_idx values (2, '9');

1 rows affected.

SQL> insert into t_bd_default_idx values (3, '11');

1 rows affected.

SQL> commit;

Succeed.

SQL> create index ix_bd_default on t_bd_default_idx (
  2     to_binary_double(txt default '9' on conversion error));

Succeed.

SQL> analyze table t_bd_default_idx compute statistics;

Succeed.

SQL> select /*+ INDEX(t ix_bd_default) */ case when count(*) = 2
  2     then 'PASS' else 'FAIL' end as i01_default_index
  3 from t_bd_default_idx t
  4 where to_binary_double(txt default '9' on conversion error) = to_binary_double('9');

I01_DEFAULT_INDEX
-----------------
PASS

1 rows fetched.

SQL> -- Both queries must raise a conversion error instead of reusing DEFAULT index keys.
SQL> select /*+ INDEX(t ix_bd_default) */ id from t_bd_default_idx t
  2 where to_binary_double(txt, '9') = to_binary_double('9') order by id;

OG-00636, Invalid number
SQL> select /*+ FULL(t) */ id from t_bd_default_idx t
  2 where to_binary_double(txt, '9') = to_binary_double('9') order by id;

OG-00636, Invalid number
SQL>
SQL> drop index ix_bd_default;

Succeed.

SQL> delete from t_bd_default_idx where id <> 2;

2 rows affected.

SQL> commit;

Succeed.

SQL> -- Reversing the expressions must not make them duplicate index columns.
SQL> create index ix_bd_format_default on t_bd_default_idx (
  2     to_binary_double(txt, '9'), to_binary_double(txt default '9' on conversion error));

Succeed.

SQL> analyze table t_bd_default_idx compute statistics;

Succeed.

SQL> select /*+ INDEX(t ix_bd_format_default) */ case when count(*) = 1
  2     then 'PASS' else 'FAIL' end as i02_format_index
  3 from t_bd_default_idx t
  4 where to_binary_double(txt, '9') = to_binary_double('9');

