SQL> prompt === INITCAP multibyte CTAS length inference ===

=== INITCAP multibyte CTAS length inference ===
SQL> -- Use table columns so constant folding cannot hide an undersized result type.
SQL> create table t_initcap_length_src (id integer, b varchar(2 byte), c varchar(1 char));

Succeed.

SQL> insert into t_initcap_length_src values (1, 'ȿ', 'ȿ');

1 rows affected.

SQL> insert into t_initcap_length_src values (2, 'a', 'a');

1 rows affected.

SQL> insert into t_initcap_length_src values (3, null, null);

1 rows affected.

SQL> commit;

Succeed.

SQL> create table t_initcap_length_dst as
  2 select id, initcap(b) as b, initcap(c) as c from t_initcap_length_src;

Succeed.

SQL> select case when rawtohex(b) = 'E2B1BE' and lengthb(b) = 3
  2        then 'PASS' else 'FAIL' end as i14_byte_ctas
  3 from t_initcap_length_dst where id = 1;

I14_BYTE_CTAS
-------------
PASS         

1 rows fetched.

SQL> select case when rawtohex(c) = 'E2B1BE' and length(c) = 1 and lengthb(c) = 3
  2        then 'PASS' else 'FAIL' end as i15_char_ctas
  3 from t_initcap_length_dst where id = 1;

I15_CHAR_CTAS
-------------
PASS         

1 rows fetched.

SQL> select case when b = 'A' and c = 'A' and lengthb(b) = 1 and lengthb(c) = 1
  2        then 'PASS' else 'FAIL' end as i16_ascii_ctas
  3 from t_initcap_length_dst where id = 2;

I16_ASCII_CTAS
--------------
PASS          

