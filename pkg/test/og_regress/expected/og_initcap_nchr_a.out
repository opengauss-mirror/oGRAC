

SQL> -- INITCAP/NCHR A-compatible function verification.
SQL> -- Text assertions and RAWTOHEX are used so client locale/display does not
SQL> -- affect the Oracle/oGRAC comparison.
SQL> alter system set use_bison_parser = true scope = memory;

Succeed.

SQL> set feedback on;

ON
SQL> set heading on;

ON
SQL> 
