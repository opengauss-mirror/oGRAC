SQL> prompt === expected errors and explicit contractions ===

=== expected errors and explicit contractions ===
SQL> select initcap() as e01_initcap_no_arg from sys.sys_dummy;

OG-00615, [1:8]Invalid argument number for INITCAP, min=1, max=1
SQL> select initcap('a', 'b') as e02_initcap_many_args from sys.sys_dummy;

OG-00615, [1:8]Invalid argument number for INITCAP, min=1, max=1
SQL> select nchr() as e03_nchr_no_arg from sys.sys_dummy;

OG-00615, [1:8]Invalid argument number for NCHR, min=1, max=1
SQL> select nchr(1, 2) as e04_nchr_many_args from sys.sys_dummy;

OG-00615, [1:8]Invalid argument number for NCHR, min=1, max=1
SQL> select nchr(-1) as e05_nchr_negative from sys.sys_dummy;

OG-00614, [1:8]Parameter error: argument value of NCHR must be between 0 and 4294967295
SQL> select nchr(4294967296) as e06_nchr_too_large from sys.sys_dummy;

OG-00614, [1:8]Parameter error: argument value of NCHR must be between 0 and 4294967295
SQL> select nchr(55296) as e07_high_surrogate from sys.sys_dummy;

OG-00614, [1:8]Parameter error: NCHR does not support a standalone UTF-16 surrogate code unit
SQL> select nchr(57343) as e08_low_surrogate from sys.sys_dummy;

OG-00614, [1:8]Parameter error: NCHR does not support a standalone UTF-16 surrogate code unit
SQL> select nchr(date '2026-08-31') as e09_nchr_date from sys.sys_dummy;

OG-00606, [1:13]Inconsistent datatypes, expected NUMBER - got DATE
