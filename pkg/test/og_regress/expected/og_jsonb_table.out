SQL> drop table if exists jsonb_tbl_test;

Succeed.

SQL> create table jsonb_tbl_test (a jsonb, b int);

Succeed.

SQL> insert into jsonb_tbl_test values('{"a":100, "b":200}', 1);

1 rows affected.

