

SQL> -- issue #389: switching use_bison_parser at runtime must not serve plans cached under the other parser mode
SQL> -- '1234'::nchar varying is rejected on the bison path (nvarchar requires a size)
SQL> -- and accepted on the native path (nchar + column alias "varying").
SQL> alter system set use_bison_parser = true;

Succeed.

SQL> select '1234'::nchar varying; --error

OG-00601, [1:29]Sql syntax error: the column size must be specified
SQL> alter system set use_bison_parser = false;

Succeed.

SQL> select '1234'::nchar varying;

VARYING
-------
1      

1 rows fetched.

SQL> alter system set use_bison_parser = true;

Succeed.

SQL> select '1234'::nchar varying; --error (must be reparsed, not served from the native-mode cache)

OG-00601, [1:29]Sql syntax error: the column size must be specified
SQL> alter system set use_bison_parser = false;

Succeed.

SQL> select '1234'::nchar varying;

VARYING
-------
1      

1 rows fetched.

SQL> 


