SQL> set serveroutput on;

ON
SQL> declare
  2     v_real real;
  3     v_real_null real := null;
  4     v_number number := 5;
  5     v_zero number := 0;
  6     v_status varchar(4);
  7     v_result real;
  8 begin
  9     v_real := to_binary_double('NaN');
 10     execute immediate 'select case when nanvl(:1, 7) = 7 then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 11         into v_status using in v_real;
 12     dbe_output.print_line('B01_NANVL_REAL_NAN: ' || v_status);
 13
 14     v_real := 1.25;
 15     execute immediate 'select case when nanvl(:1, 7) = 1.25 then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 16         into v_status using in v_real;
 17     dbe_output.print_line('B02_NANVL_REAL_FINITE: ' || v_status);
 18
 19     v_real := 5;
 20     execute immediate 'select case when nanvl(remainder(:1, 0), 999) = 999 ' ||
 21         'then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 22         into v_status using in v_real;
 23     dbe_output.print_line('B03_REMAINDER_REAL_ZERO: ' || v_status);
 24
 25     v_real := 11;
 26     execute immediate 'select case when remainder(:1, 4) = -1 then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 27         into v_status using in v_real;
 28     dbe_output.print_line('B04_REMAINDER_REAL_FINITE: ' || v_status);
 29
 30     v_real := to_binary_double('NaN');
 31     execute immediate 'select case when nanvl(remainder(:1, 4), 999) = 999 ' ||
 32         'then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 33         into v_status using in v_real;
 34     dbe_output.print_line('B05_REMAINDER_REAL_NAN: ' || v_status);
 35
 36     execute immediate 'select case when nanvl(:1, 7) is null then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 37         into v_status using in v_real_null;
 38     dbe_output.print_line('B06_NANVL_REAL_NULL: ' || v_status);
 39
 40     execute immediate 'select case when remainder(:1, 4) is null then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 41         into v_status using in v_real_null;
 42     dbe_output.print_line('B07_REMAINDER_REAL_NULL: ' || v_status);
 43
 44     execute immediate 'select case when nanvl(:1, :2) = 5 then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 45         into v_status using in v_number, in v_real_null;
 46     dbe_output.print_line('B08_NANVL_NULL_REPLACEMENT: ' || v_status);
 47
 48     execute immediate 'select case when remainder(11, :1) is null then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 49         into v_status using in v_real_null;
 50     dbe_output.print_line('B09_REMAINDER_NULL_DIVISOR: ' || v_status);
 51
 52     v_real := 1.25;
 53     execute immediate 'select case when nanvl(:1, 1 / :2) = 1.25 then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 54         into v_status using in v_real, in v_zero;
 55     dbe_output.print_line('B10_NANVL_LAZY_REPLACEMENT: ' || v_status);
 56
 57     execute immediate 'select case when nanvl(:1, 1 / :2) is null ' ||
 58         'then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 59         into v_status using in v_real_null, in v_zero;
 60     dbe_output.print_line('B11_NANVL_NULL_SHORT_CIRCUIT: ' || v_status);
 61
 62     execute immediate 'select case when remainder(:1, 1 / :2) is null ' ||
 63         'then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 64         into v_status using in v_real_null, in v_zero;
 65     dbe_output.print_line('B12_REMAINDER_NULL_SHORT_CIRCUIT: ' || v_status);
 66
 67     v_real := 0;
 68     execute immediate 'select case when nanvl(remainder(:1, :2), 999) = 999 ' ||
 69         'then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 70         into v_status using in v_number, in v_real;
 71     dbe_output.print_line('B13_REMAINDER_SECOND_REAL: ' || v_status);
 72
 73     v_real := to_binary_double('NaN');
 74     execute immediate 'select case when v = 7 then ''PASS'' else ''FAIL'' end ' ||
 75         'from (select nanvl(:1, 7) v from sys.sys_dummy) t'
 76         into v_status using in v_real;
 77     dbe_output.print_line('B14_NANVL_BOUND_SUBQUERY: ' || v_status);
 78
 79     begin
 80         execute immediate 'select remainder(:1, 0) from sys.sys_dummy'
 81             into v_result using in v_number;
 82         dbe_output.print_line('B15_REMAINDER_NUMBER_ZERO: FAIL');
 83     exception
 84         when zero_divide then
 85             dbe_output.print_line('B15_REMAINDER_NUMBER_ZERO: PASS');
 86     end;
 87
 88     begin
 89         execute immediate 'select nanvl(:1, 1 / :2) from sys.sys_dummy'
 90             into v_result using in v_real, in v_zero;
 91         dbe_output.print_line('B16_NANVL_USED_REPLACEMENT: FAIL');
 92     exception
 93         when zero_divide then
 94             dbe_output.print_line('B16_NANVL_USED_REPLACEMENT: PASS');
 95     end;
 96
 97     execute immediate 'select case when nanvl(:1, :2) is null then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
 98         into v_status using in v_real, in v_real_null;
 99     dbe_output.print_line('B17_NANVL_NAN_NULL_REPLACEMENT: ' || v_status);
100
101     execute immediate 'select case when (select nanvl(:1, 7) from sys.sys_dummy where 1 = 0) is null ' ||
102         'then ''PASS'' else ''FAIL'' end from sys.sys_dummy'
103         into v_status using in v_real;
104     dbe_output.print_line('B18_NANVL_EMPTY_SCALAR: ' || v_status);
105 end;
106 /

