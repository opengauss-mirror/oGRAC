SQL> 
SQL> /* bare close: nothing follows the closing mark
  2    note */
SQL> select 3 as c03 from sys.sys_dummy;

C03         
------------
3           

1 rows fetched.

SQL> 
SQL> /* header comment
  2    ahead of a procedure block */
SQL> create or replace procedure p_comment_close as
  2 begin
  3     null;
  4 end;
  5 /

Succeed.

SQL> 
SQL> drop procedure p_comment_close;

Succeed.

SQL> 
SQL> /* header on the same line as the block start */ create or replace procedure p_comment_close2 as
  2 begin
  3     null;
  4 end;
  5 /

Succeed.

SQL> 
SQL> drop procedure p_comment_close2;

Succeed.

SQL> 
SQL> /* a quote in the comment body: don't */
SQL> select 4 as c04 from sys.sys_dummy;

