SQL> -- Function indexes must distinguish DEFAULT values from format arguments.
SQL> create table t_bf_default_idx (id integer, txt varchar(40));

Succeed.

SQL> insert into t_bf_default_idx values (1, 'bad');

1 rows affected.

SQL> insert into t_bf_default_idx values (2, '9');

1 rows affected.

SQL> insert into t_bf_default_idx values (3, '11');

1 rows affected.

SQL> commit;

Succeed.

SQL> create index ix_bf_default on t_bf_default_idx (
  2     to_binary_float(txt default '9' on conversion error));

Succeed.

SQL> analyze table t_bf_default_idx compute statistics;

Succeed.

SQL> select /*+ INDEX(t ix_bf_default) */ case when count(*) = 2
  2     then 'PASS' else 'FAIL' end as i01_default_index
  3 from t_bf_default_idx t
  4 where to_binary_float(txt default '9' on conversion error) = to_binary_float('9');

