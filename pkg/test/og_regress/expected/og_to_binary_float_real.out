SQL> -- Both queries must raise a conversion error instead of reusing DEFAULT index keys.
SQL> select /*+ INDEX(t ix_bf_default) */ id from t_bf_default_idx t
  2 where to_binary_float(txt, '9') = to_binary_float('9') order by id;

OG-00636, Invalid number
SQL> select /*+ FULL(t) */ id from t_bf_default_idx t
  2 where to_binary_float(txt, '9') = to_binary_float('9') order by id;

OG-00636, Invalid number
