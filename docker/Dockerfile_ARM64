FROM openeuler/openeuler:22.03-lts-sp1

# oGRAC requires English locale, otherwise database startup may fail.
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV PYTHON3_HOME=/usr/include/python3.9

# Workaround for build environments that use self-signed certificates or plain HTTP mirrors.
RUN touch /root/.curlrc && sed -i "$a insecure" /root/.curlrc
RUN touch /root/.wgetrc && sed -i "$a check_certificate = off" /root/.wgetrc
RUN yum clean all && echo 'sslverify=False' >> /etc/yum.conf
RUN yum update -y

# glibc-langpack-en does not exist in the openEuler 22.03 repo and would be
# silently skipped by --skip-broken. The glibc upgrade during "yum update"
# ships a full locale archive as *.rpmnew; restore it so en_US.UTF-8 works.
RUN cp -f /usr/lib/locale/locale-archive.default.rpmnew /usr/lib/locale/locale-archive 2>/dev/null || true

# Install dependencies for compiling and running oGRAC inside the container.
# Based on: https://docs.opengauss.org/zh/docs/latest/ograc/installation_guide/single_node_guide/containerized_single_node_installation.html
RUN yum install -y \
    libaio-devel openssl openssl-devel ndctl-devel \
    ncurses ncurses-devel libtirpc-devel expect ant bison iputils \
    iproute wget make gcc gcc-c++ gdb gdb-gdbserver python3 python3-devel \
    git net-tools cmake automake byacc libtool unzip vim lz4 lz4-devel patch \
    xz flex unixODBC-devel unixODBC libasan rpcgen numactl numactl-devel --skip-broken

# Requirements: cmake >= 3.12, lz4 >= 1.8.3.

# Create directories used by oGRAC regression / single-node installs.
RUN mkdir -p /cores /home/regress

WORKDIR /home/regress

EXPOSE 1611

CMD ["tail", "-f", "/dev/null"]
